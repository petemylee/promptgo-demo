// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Requester
  Driver
  Admin
  Executive
}

enum BookingStatus {
  PENDING
  APPROVED
  CONFIRMED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  MERGED
}

enum TripType {
  ONE_WAY
  PICK_UP
  ROUND_TRIP
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  position          String?
  password          String
  role              Role      @default(Requester)
  phoneNumber       String?
  profileImageUrl   String?
  signatureImageUrl String?
  lineUserId        String?   @unique  // LINE User ID after account binding (for notifications)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  bookingsRequested      Booking[] @relation("RequesterBookings")
  bookingsDriven         Booking[] @relation("DriverTrips")
  bookingsApprovedByAdmin Booking[] @relation("AdminApprovals")
  bookingsConfirmedByExec Booking[] @relation("ExecutiveConfirmations")
  driverFeedbackGivenAsRequester DriverFeedback[] @relation("RequesterDriverFeedback")
  driverFeedbackReceived DriverFeedback[] @relation("DriverFeedbackReceived")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Vehicle {
  id             String    @id @default(cuid())
  licensePlate   String    @unique
  brand           String?
  model           String?
  type            String?
  capacity        Int?
  currentMileage  Int?      // เลขไมล์ปัจจุบัน
  vehicleImageUrl String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings Booking[]
}

model Booking {
  id                  String         @id @default(cuid())
  purpose             String?
  endLocation         String?
  startTime           DateTime?
  endTime             DateTime?
  passengerCount      Int?
  tripType            TripType?
  status              BookingStatus  @default(PENDING)
  generatedFormUrl    String?
  requesterSignatureUrl String?      // ลายเซ็นผู้ขอใช้รถ
  passengerImageUrl   String?        // รูปภาพผู้โดยสาร
  startMileage        Int?           // เลขไมล์ก่อนออกเดินทาง
  endMileage          Int?           // เลขไมล์หลังเดินทาง
  executiveConfirmedAt DateTime?     // วันที่ Executive ยืนยัน
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  requesterId           String
  driverId              String?
  vehicleId             String?
  adminApproverId       String?
  executiveConfirmerId  String?

  requester          User      @relation("RequesterBookings", fields: [requesterId], references: [id])
  driver             User?     @relation("DriverTrips", fields: [driverId], references: [id])
  vehicle            Vehicle?  @relation(fields: [vehicleId], references: [id])
  adminApprover      User?     @relation("AdminApprovals", fields: [adminApproverId], references: [id])
  executiveConfirmer User?     @relation("ExecutiveConfirmations", fields: [executiveConfirmerId], references: [id])

  feedback           Feedback?
  driverFeedback     DriverFeedback?
}

// Feedback จาก Requester (ผู้ขอใช้รถ) ให้คนขับ (Admin, Executive, Driver เห็นได้)
model DriverFeedback {
  id        String   @id @default(cuid())
  rating    Int      // 1-5 ดาว
  comment   String?  // ข้อเสนอแนะเพิ่มเติม (ไม่บังคับ)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverId    String
  requesterId String
  bookingId   String   @unique

  driver    User    @relation("DriverFeedbackReceived", fields: [driverId], references: [id], onDelete: Cascade)
  requester User    @relation("RequesterDriverFeedback", fields: [requesterId], references: [id], onDelete: Cascade)
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
}