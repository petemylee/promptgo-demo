# =============================================================================
# OFM PROMPTGO — คัดลอกเป็น .env แล้วกรอกค่าจริง (อย่า commit .env)
# รายละเอียดแต่ละตัวแปร: docs/environment-variables.md
# =============================================================================

# --- Database (จำเป็น) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- NextAuth (จำเป็น) ---
# สร้างค่าแบบสุ่มยาว ๆ เช่น: openssl rand -base64 32
NEXTAUTH_SECRET=""
# URL ของแอปที่ผู้ใช้เข้าถึงได้ (local: http://localhost:3000, production: https://your-domain)
NEXTAUTH_URL="http://localhost:3000"

# --- แอป / ลิงก์รีเซ็ตรหัส (แนะนำใน production) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- LINE Messaging API — ส่งข้อความ Push / Webhook ยืนยันตัวตน (จำเป็นถ้าใช้ LINE ในระบบ) ---
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# --- LINE Login (NextAuth provider Line) — ต้องตรงกับ Channel ที่เปิด LINE Login ---
# Channel ID ใช้ทั้งฝั่งเซิร์ฟเวอร์และฝั่ง client (NEXT_PUBLIC_*)
NEXT_PUBLIC_LINE_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""
# ถ้าไม่ตั้ง LINE_LOGIN_CHANNEL_SECRET บาง route จะ fallback เป็น LINE_CHANNEL_SECRET

# --- LINE Push API (ถ้าเรียก /api/line/push แบบมีการป้องกันด้วย secret) ---
LINE_PUSH_API_SECRET=""

# --- Supabase — อัปโหลดไฟล์ / Storage (จำเป็นถ้าใช้ฟีเจอร์อัปโหลด) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# ถ้าไม่ตั้ง NEXT_PUBLIC_* บางโค้ดอ่าน SUPABASE_URL / SUPABASE_ANON_KEY แทนได้

# --- SMTP — ลืมรหัสผ่าน /อีเมล (ถ้าไม่ตั้ง SMTP_HOST ฟีเจอร์อีเมลจะไม่ทำงาน) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# --- Prisma / connection pool (ทางเลือก — ค่าเริ่มต้นในโค้ด: limit 1, timeout 30s) ---
PRISMA_CONNECTION_LIMIT="1"
PRISMA_POOL_TIMEOUT="30"
